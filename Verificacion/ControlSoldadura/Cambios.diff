+                if (Torch != null && Torch.IgnoreRoot != null && hit.IsChildOf(Torch.IgnoreRoot)) continue;
+                if (hit.gameObject.layer == 5 || hit == Ik.target || hit == _marker) continue;
+                allowed = Mathf.Min(allowed, Mathf.Max(0f, _motionHits[i].distance - 0.003f));
+            }
+            return origin + delta / length * allowed;
